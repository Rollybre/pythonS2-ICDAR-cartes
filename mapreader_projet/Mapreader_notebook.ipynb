   "source": [
    "#Fonction de conversion de la métadata de la compétition en version GeoJSON compatible avec mapreader :\n",
    "\n",
    "\n",
    "# Chemin de sortie à modifier en fonction (le fichier sera créé à la fin du code):\n",
    "# NTS : Je pourrais ajouter une variable d'entrée ou on donne le nom de fichier qu'on souhaite\n",
    "# puis un check os voir si le fichier est déjà créé ou non mais je verrai sans doute plus tard\n",
    "path = \"/content/drive/MyDrive/map_project/output_metadata.geojson\"\n",
    "\n",
    "\n",
    "def metadata_get (fichier_json):\n",
    "\n",
    "    if os.path.exists(path):\n",
    "        with open(path, \"r\",encoding=\"utf-8\") as meta:\n",
    "            metadata = json.load(meta)\n",
    "            print(\"Path already exists\")\n",
    "\n",
    "    else :\n",
    "        #On load le json que l'on a (observer au préalable sa structure pour pouvoir le manipuler)\n",
    "        with open(fichier_json) as f:\n",
    "            data = json.load(f)\n",
    "\n",
    "        #Variable features à remplir pour la fin\n",
    "        features = []\n",
    "\n",
    "        for item in tqdm(data):\n",
    "            image = item.get(\"image\")\n",
    "            #Ici prendre seulement le nom de l'image et son extension et non pas \"sample/nomImage.png\"\n",
    "            image_id = os.path.basename(image) if image else None\n",
    "            for group in item.get(\"groups\", []):\n",
    "                for element in group:\n",
    "                    vertices = element[\"vertices\"]\n",
    "\n",
    "                    if vertices[0] != vertices[-1]:\n",
    "                        vertices.append(vertices[0])\n",
    "                    polygon = [[ [x, y] for x, y in vertices ]]\n",
    "                    #On donne le format que l'on souhaite avoir à la fin pour chaque entrée dans le GéoJson, cela sera plus\n",
    "                    #facile à interpréter quand le df sera imprimé et manipulable\n",
    "                    feature = {\n",
    "                        \"type\": \"Feature\",\n",
    "                        \"geometry\": {\n",
    "                            \"type\": \"Polygon\",\n",
    "                            \"coordinates\": polygon\n",
    "                        },\n",
    "                        \"properties\": {\n",
    "                            \"text\": element[\"text\"],\n",
    "                            \"image_id\": image_id,\n",
    "                            \"illegible\": element.get(\"illegible\", False),\n",
    "                            \"truncated\": element.get(\"truncated\", False)\n",
    "                        }\n",
    "                    }\n",
    "                    #On ajoute tout ça à la variable créée précédemment\n",
    "                    features.append(feature)\n",
    "        # Et on fait le fichier final geojson\n",
    "        geojson = {\n",
    "            \"type\": \"FeatureCollection\",\n",
    "            \"features\": features\n",
    "        }\n",
    "\n",
    "        #Fait un os.makedir exist=OK et sinon ne pas le créer puisqu'il sera déjà dans le dossier correspondant\n",
    "        #Comme conseillé, le path que j'ai indiqué créé le geojson dans le même dossier que les images parents\n",
    "\n",
    "        with open(path, \"w\") as f:\n",
    "            json.dump(geojson, f, indent=2)\n",
    "\n",
    "        #On ouvre le nouveau fichier une fois créé (ou celui déjà créé en fonction) et on le retourne pour le manipuler\n",
    "        with open(path, \"r\",encoding=\"utf-8\") as meta:\n",
    "            metadata = json.load(meta)\n",
    "\n",
    "    return metadata"
   ]
  },
